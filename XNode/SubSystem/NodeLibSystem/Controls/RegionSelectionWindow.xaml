<Window x:Class="XNode.SubSystem.NodeLibSystem.Controls.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择区域"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid>
        <Rectangle Fill="#80000000" />

        <Canvas x:Name="SelectionCanvas"
                Background="Transparent"
                MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                MouseMove="SelectionCanvas_MouseMove"
                MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp">
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="DodgerBlue"
                       StrokeThickness="2"
                       StrokeDashArray="6 2"
                       Fill="#4080BFFF"
                       Visibility="Collapsed"
                       RadiusX="2"
                       RadiusY="2" />

            <Border x:Name="InfoPanel"
                    Background="#CC1E1E1E"
                    CornerRadius="4"
                    Padding="6"
                    Opacity="0.95"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="CoordinateText"
                               Foreground="White"
                               FontSize="12"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="SizeText"
                               Foreground="White"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0"
                Background="#AA1E1E1E"
                CornerRadius="6"
                Padding="12">
            <TextBlock Text="拖拽鼠标选择区域，按 Esc 取消"
                       Foreground="White"
                       FontSize="16"
                       TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
