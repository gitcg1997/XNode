<UserControl x:Class="XNode.SubSystem.NodeLibSystem.Controls.RegionSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260">
    <Border Background="#1E1E1E"
            BorderBrush="#2F6CF6"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <Button x:Name="SelectRegionButton"
                        Content="选择屏幕区域"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        MinWidth="120"
                        Foreground="White"
                        Background="#2F6CF6"
                        BorderBrush="#4A7FE8"
                        Click="SelectRegionButton_Click" />
                <Button x:Name="ClearButton"
                        Content="重置"
                        Padding="10,4"
                        MinWidth="70"
                        Foreground="White"
                        Background="#2F6CF6"
                        BorderBrush="#4A7FE8"
                        Click="ClearButton_Click" />
            </DockPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                    <TextBlock Text="X"
                               Foreground="LightGray"
                               FontSize="12" />
                    <TextBox x:Name="XTextBox"
                             Margin="0,2,0,0"
                             Padding="6,2"
                             Background="#2D2D2D"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             TextChanged="TextBox_TextChanged"
                             LostFocus="TextBox_LostFocus" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                    <TextBlock Text="Y"
                               Foreground="LightGray"
                               FontSize="12" />
                    <TextBox x:Name="YTextBox"
                             Margin="0,2,0,0"
                             Padding="6,2"
                             Background="#2D2D2D"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             TextChanged="TextBox_TextChanged"
                             LostFocus="TextBox_LostFocus" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,6,0">
                    <TextBlock Text="宽度"
                               Foreground="LightGray"
                               FontSize="12" />
                    <TextBox x:Name="WidthTextBox"
                             Margin="0,2,0,0"
                             Padding="6,2"
                             Background="#2D2D2D"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             TextChanged="TextBox_TextChanged"
                             LostFocus="TextBox_LostFocus" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,6,0,0">
                    <TextBlock Text="高度"
                               Foreground="LightGray"
                               FontSize="12" />
                    <TextBox x:Name="HeightTextBox"
                             Margin="0,2,0,0"
                             Padding="6,2"
                             Background="#2D2D2D"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             TextChanged="TextBox_TextChanged"
                             LostFocus="TextBox_LostFocus" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="SummaryText"
                       Margin="0,6,0,0"
                       Foreground="LightGray"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="尚未选择区域" />
        </StackPanel>
    </Border>
</UserControl>
