<local:PinGroupViewBase x:Class="XNode.SubSystem.NodeEditSystem.Control.ImagePathPinGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XNode.SubSystem.NodeEditSystem.Control"
             mc:Ignorable="d"
             d:DesignWidth="320" Height="25">
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="InputBoxArea" Width="120"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>

        <!-- 左引脚 -->
        <Image x:Name="Icon_LeftPin" Width="11" Height="11" IsHitTestVisible="False" Grid.Column="0"/>
        <Grid x:Name="LeftPinArea" Background="Transparent" Grid.Column="0" Width="17" Height="17"/>

        <!-- 数据名称 -->
        <TextBlock x:Name="Block_Name" Text="模板路径"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Grid.Column="1" Foreground="White" Margin="1,0,5,0"/>

        <!-- 路径输入框 -->
        <TextBox x:Name="Input_Value"
                 Grid.Column="2"
                 VerticalAlignment="Center"
                 Height="20"
                 Padding="2"
                 Background="#3A3A3A"
                 Foreground="White"
                 BorderBrush="#606060"
                 BorderThickness="1"
                 Margin="0,0,2,0"/>

        <!-- 预览图标按钮 -->
        <Border x:Name="PreviewIconButton"
                Grid.Column="3"
                Width="20" Height="20"
                Background="#2A2A2A"
                BorderBrush="#606060"
                BorderThickness="1"
                CornerRadius="3"
                VerticalAlignment="Center"
                Margin="2,0,2,0"
                Cursor="Hand"
                ToolTip="鼠标悬停预览图像"
                MouseEnter="PreviewIcon_MouseEnter"
                MouseLeave="PreviewIcon_MouseLeave">
            <TextBlock Text="👁" 
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#9B7BC7"/>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3A3A3A"/>
                            <Setter Property="BorderBrush" Value="#9B7BC7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- 浏览按钮 -->
        <Button x:Name="BrowseButton"
                Grid.Column="4"
                Width="26" Height="20"
                Content="📁"
                ToolTip="浏览本地文件"
                VerticalAlignment="Center"
                Background="#4A7BA7"
                Foreground="White"
                BorderBrush="#6A9BC7"
                BorderThickness="1"
                Padding="0"
                Margin="1,0,1,0"
                Cursor="Hand"
                Click="BrowseButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#4A7BA7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#5A8BC7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#3A6B97"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 图像库按钮 -->
        <Button x:Name="LibraryButton"
                Grid.Column="5"
                Width="26" Height="20"
                Content="🖼"
                ToolTip="从图像库选择"
                VerticalAlignment="Center"
                Background="#7B5BA7"
                Foreground="White"
                BorderBrush="#9B7BC7"
                BorderThickness="1"
                Padding="0"
                Margin="1,0,1,0"
                Cursor="Hand"
                Click="LibraryButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#7B5BA7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#8B6BC7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#6B4B97"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 右引脚 -->
        <Image x:Name="Icon_RightPin" Width="11" Height="11" Grid.Column="6" IsHitTestVisible="False"/>
        <Grid x:Name="RightPinArea" Background="Transparent" Grid.Column="6" Width="17" Height="17"/>

        <!-- 悬停预览弹出层 -->
        <Popup x:Name="HoverPreviewPopup"
               AllowsTransparency="True"
               Placement="Right"
               PlacementTarget="{Binding ElementName=PreviewIconButton}"
               HorizontalOffset="10"
               VerticalOffset="-80"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border Background="#2A2A2A"
                    BorderBrush="#9B7BC7"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="8"
                    MaxWidth="400"
                    MaxHeight="300">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" 
                                    Direction="270" 
                                    ShadowDepth="4" 
                                    Opacity="0.6" 
                                    BlurRadius="16"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <TextBlock Grid.Row="0"
                               Text="图像预览"
                               Foreground="#9B7BC7"
                               FontWeight="Bold"
                               FontSize="11"
                               Margin="0,0,0,6"/>

                    <!-- 图像内容 -->
                    <Grid Grid.Row="1" MinWidth="200" MinHeight="150">
                        <!-- 加载指示器 -->
                        <StackPanel x:Name="PopupLoadingPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <ProgressBar IsIndeterminate="True"
                                       Width="100" Height="4"
                                       Foreground="#9B7BC7"/>
                            <TextBlock Text="加载中..."
                                     Foreground="LightGray"
                                     FontSize="10"
                                     HorizontalAlignment="Center"
                                     Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 图像显示 -->
                        <Image x:Name="PopupPreviewImage"
                               Stretch="Uniform"
                               MaxHeight="280"
                               MaxWidth="380"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- 错误/空状态提示 -->
                        <TextBlock x:Name="PopupErrorText"
                                   Text="无预览"
                                   Foreground="#888888"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- 底部信息栏 -->
                    <StackPanel Grid.Row="2" 
                                Margin="0,6,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="PopupImageInfo"
                                   Foreground="#888888"
                                   FontSize="9"
                                   Text=""/>
                        <TextBlock x:Name="PopupFileSizeInfo"
                                   Foreground="#888888"
                                   FontSize="9"
                                   Margin="8,0,0,0"
                                   Text=""/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</local:PinGroupViewBase>
