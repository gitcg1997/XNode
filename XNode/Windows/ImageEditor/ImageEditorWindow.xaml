<Window x:Class="XNode.Windows.ImageEditor.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="图像编辑器 - XNode"
        Width="900"
        Height="900"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 引入应用样式 -->
                <ResourceDictionary Source="/XNode;component/Windows/ImageEditor/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 通用图标样式 -->
            <Style x:Key="Icon16Style" TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Icon18OnPrimaryStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 主布局容器 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶部工具栏 -->
            <RowDefinition Height="*"/>
            <!-- 主内容区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部操作栏 -->
        </Grid.RowDefinitions>

        <!-- ========================================
             顶部工具栏区域
             ======================================== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarContainerStyle}" Margin="0,0,0,38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 应用标题和图标 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SecondaryGradientBrush}"
                            CornerRadius="{StaticResource RadiusMD}"
                            Width="32" Height="32"
                            Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="ImageEdit" Style="{StaticResource Icon18OnPrimaryStyle}"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="图像编辑器"
                                 Style="{StaticResource TitleTextStyle}"
                                 Margin="0,0,0,2"/>
                        <TextBlock Text="Image Editor"
                                 Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中间空白区域 -->
                <Grid Grid.Column="1"/>

                <!-- 主要操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="CaptureButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CaptureButton_Click"
                            Margin="0,0,12,0"
                            ToolTip="获取图片 (F3)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImagePlus" Style="{StaticResource Icon16Style}"/>
                            <TextBlock Text="获取图片 (F3)"/>
                        </StackPanel>
                    </Button>

                    <Button Name="RecaptureButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RecaptureButton_Click"
                            IsEnabled="False"
                            Margin="0,0,12,0"
                            ToolTip="重新捕获屏幕图像 (F4)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Camera" Style="{StaticResource Icon16Style}"/>
                            <TextBlock Text="重新捕获 (F4)"/>
                        </StackPanel>
                    </Button>

                    <Button Name="ImageLibraryButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ImageLibraryButton_Click"
                            ToolTip="打开图片数据库,选择模板图片">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DatabasePlus" Style="{StaticResource Icon16Style}"/>
                            <TextBlock Text="添加数据库"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================
             主内容区域
             ======================================== -->
        <Border Grid.Row="1" Style="{StaticResource ContentAreaStyle}">
            <TabControl Name="MainTabControl"
                        SelectionChanged="MainTabControl_SelectionChanged"
                        Background="Transparent"
                        BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="TabBorder"
                                            Background="Transparent"
                                            BorderThickness="0,0,0,2"
                                            BorderBrush="Transparent"
                                            Padding="20,12"
                                            Margin="0,0,8,0"
                                            Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: 截图识别 -->
                <TabItem Name="ScreenshotTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImageArea" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="截图识别" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350" MinWidth="300"/>
                                <!-- 控制面板区域 -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- 分隔符 -->
                                <ColumnDefinition Width="*" MinWidth="400"/>
                                <!-- 图像预览区域 -->
                            </Grid.ColumnDefinitions>

                            <!-- 左侧控制面板 -->
                            <GroupBox Grid.Column="0"
                                    Style="{StaticResource GroupContainerStyle}"
                                    Margin="0,0,8,0">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="图像设置"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="{StaticResource SpacingMD}">
                            <!-- 元素名称 -->
                            <TextBlock Text="元素名称"
                                     Style="{StaticResource SubtitleTextStyle}"
                                     Margin="0,0,0,8"/>
                            <TextBox Name="ElementNameTextBox"
                                   Text="图像元素"
                                   Margin="0,0,0,24"/>

                            <!-- 操作按钮 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 校验按钮 -->
                                <Button Name="ValidateButton"
                                        Grid.Column="0"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Click="ValidateButton_Click"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="CheckCircle" Style="{StaticResource Icon16Style}"/>
                                        <TextBlock Text="校验 [F7]"/>
                                    </StackPanel>
                                </Button>

                                <!-- 保存按钮 -->
                                <Button Name="SaveImageButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveImageButton_Click"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="ContentSave" Style="{StaticResource Icon16Style}"/>
                                        <TextBlock Text="保存截图"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 保存路径设置 -->
                            <TextBlock Text="大文件保存路径 (>2MB)"
                                     Style="{StaticResource SubtitleTextStyle}"
                                     Margin="0,16,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Name="SavePathTextBox"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,0"
                                         Text="未设置"/>

                                <Button Name="SetSavePathButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="SetSavePathButton_Click"
                                        ToolTip="设置大文件保存路径">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderCog" Style="{StaticResource Icon16Style}"/>
                                        <TextBlock Text="设置路径"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 识别相似度 -->
                            <TextBlock Text="识别相似度"
                                     Style="{StaticResource SubtitleTextStyle}"
                                     Margin="0,0,0,8"/>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="{StaticResource BorderThin}"
                                    CornerRadius="{StaticResource RadiusSM}"
                                    Padding="{StaticResource SpacingMD}"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Name="SimilaritySlider"
                                              Grid.Column="0"
                                              Minimum="0"
                                              Maximum="100"
                                              Value="80"
                                              TickFrequency="10"
                                              IsSnapToTickEnabled="True"
                                              ValueChanged="SimilaritySlider_ValueChanged"/>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="8,4"
                                                Margin="8,0,0,0">
                                            <TextBlock Name="SimilarityValueText"
                                                     Text="80%"
                                                     Foreground="White"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                             Text="调整图像匹配的精确度，数值越高要求越严格"
                                             Style="{StaticResource CaptionTextStyle}"
                                             TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- 鼠标位置控制 -->
                            <TextBlock Text="鼠标位置控制"
                                     Style="{StaticResource SubtitleTextStyle}"
                                     Margin="0,0,0,8"/>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="{StaticResource BorderThin}"
                                    CornerRadius="{StaticResource RadiusSM}"
                                    Padding="{StaticResource SpacingMD}"
                                    Margin="0,0,0,16" Height="153">
                                <StackPanel>
                                    <!-- 当前鼠标位置显示 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>

                                    <!-- 坐标输入 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Style="{StaticResource BodyTextStyle}" Height="20"/>
                                        <TextBox Grid.Column="1" Name="MouseXTextBox"
                                                Text="0"
                                                FontFamily="Consolas"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                IsEnabled="True"
                                                IsReadOnly="False"
                                                Height="40"
                                                Padding="8,0"
                                                Background="White"
                                                Foreground="Black"
                                                BorderBrush="#CCCCCC"
                                                BorderThickness="1"/>

                                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center"
                                                 Style="{StaticResource BodyTextStyle}" Height="20"/>
                                        <TextBox Grid.Column="4" Name="MouseYTextBox"
                                                Text="0"
                                                FontFamily="Consolas"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                IsEnabled="True"
                                                IsReadOnly="False"
                                                Height="40"
                                                Padding="8,0"
                                                Background="White"
                                                Foreground="Black"
                                                BorderBrush="#CCCCCC"
                                                BorderThickness="1"/>
                                    </Grid>

                                    <!-- 移动鼠标按钮 -->
                                    <Button Name="MoveMouseButton"
                                          Style="{StaticResource SecondaryButtonStyle}"
                                          Click="MoveMouseButton_Click"
                                          HorizontalAlignment="Stretch"
                                          ToolTip="移动鼠标到指定坐标位置" Height="55">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="CursorMove" Style="{StaticResource Icon16Style}"/>
                                            <TextBlock Text="移动鼠标到指定位置"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- 分隔符 -->
                <GridSplitter Grid.Column="1"
                            Width="4"
                            Background="{StaticResource DividerBrush}"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Center"/>

                <!-- 右侧图像预览区域 -->
                <GroupBox Grid.Column="2"
                        Style="{StaticResource GroupContainerStyle}"
                        Margin="8,0,0,0">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImageOutline" Width="18" Height="18" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="图像预览"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid Margin="{StaticResource SpacingMD}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 图像信息面板 -->
                        <Border Grid.Row="0"
                              Style="{StaticResource InfoPanelStyle}"
                              Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Name="ImageWidthText"
                                             Text="0"
                                             Style="{StaticResource HeadlineTextStyle}"
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="宽度 (px)"
                                             Style="{StaticResource CaptionTextStyle}"
                                             HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Name="ImageHeightText"
                                             Text="0"
                                             Style="{StaticResource HeadlineTextStyle}"
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock Text="高度 (px)"
                                             Style="{StaticResource CaptionTextStyle}"
                                             HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Name="ImageSizeText"
                                             Text="0 KB"
                                             Style="{StaticResource HeadlineTextStyle}"
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource SecondaryBrush}"/>
                                    <TextBlock Text="文件大小"
                                             Style="{StaticResource CaptionTextStyle}"
                                             HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 图像显示区域 -->
                        <Border Grid.Row="1"
                              BorderBrush="{StaticResource DividerBrush}"
                              BorderThickness="{StaticResource BorderThin}"
                              CornerRadius="{StaticResource RadiusSM}"
                              Background="{StaticResource SurfaceBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        Background="Transparent">
                                <Image Name="PreviewImage"
                                     Stretch="None"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </GroupBox>
                        </Grid>
                    </TabItem.Content>
                </TabItem>

                <!-- Tab 2: 窗口/元素检测 -->
                <TabItem Name="DetectionTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="WindowMaximize" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="窗口/元素检测" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350" MinWidth="300"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="400"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧检测控制面板 -->
                            <GroupBox Grid.Column="0"
                                    Style="{StaticResource GroupContainerStyle}"
                                    Margin="0,0,8,0">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Target" Width="18" Height="18" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="检测设置"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="{StaticResource SpacingMD}">
                                        <!-- 检测模式选择 -->
                                        <TextBlock Text="检测模式"
                                                 Style="{StaticResource SubtitleTextStyle}"
                                                 Margin="0,0,0,8"/>
                                        <ComboBox Name="DetectionModeComboBox"
                                                Style="{StaticResource ModernComboBoxStyle}"
                                                Margin="0,0,0,24"
                                                SelectedIndex="0">
                                            <ComboBoxItem Content="窗口检测" Style="{StaticResource ModernComboBoxItemStyle}"/>
                                            <ComboBoxItem Content="UI元素检测" Style="{StaticResource ModernComboBoxItemStyle}"/>
                                        </ComboBox>

                                        <!-- 检测按钮 -->
                                        <Button Name="StartDetectionButton"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="StartDetectionButton_Click"
                                                Margin="0,0,0,24">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="Crosshairs" Style="{StaticResource Icon16Style}"/>
                                                <TextBlock Text="开始检测"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 检测到的信息 -->
                                        <TextBlock Text="检测信息"
                                                 Style="{StaticResource SubtitleTextStyle}"
                                                 Margin="0,0,0,8"/>
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="{StaticResource BorderThin}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="{StaticResource SpacingMD}"
                                                Margin="0,0,0,16"
                                                MinHeight="300">
                                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Name="DetectionInfoText"
                                                         Text="点击'开始检测'按钮，然后将鼠标移动到目标窗口或UI元素上，系统会实时显示详细信息。&#x0a;&#x0a;• 窗口检测：获取窗口句柄、标题、类名、位置、尺寸&#x0a;• UI元素检测：获取元素句柄、文本、类名、位置、尺寸"
                                                         TextWrapping="Wrap"
                                                         Style="{StaticResource BodyTextStyle}"
                                                         LineHeight="22"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>

                            <!-- 分隔线 -->
                            <Border Grid.Column="1"
                                    Width="1"
                                    Background="{StaticResource DividerBrush}"
                                    Margin="12,0"/>

                            <!-- 右侧预览区域 -->
                            <GroupBox Grid.Column="2"
                                    Style="{StaticResource GroupContainerStyle}"
                                    Margin="8,0,0,0">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Monitor" Width="18" Height="18" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="检测预览"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid Margin="{StaticResource SpacingMD}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 预览图片 -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="{StaticResource BorderThin}"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8"
                                            Margin="0,0,0,12"
                                            MaxHeight="400">
                                        <Image Name="DetectionPreviewImage"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- 提示文本 -->
                                    <TextBlock Grid.Row="1"
                                             Name="DetectionPreviewText"
                                             Text="开始检测后，当前光标下的窗口/元素截图将在此处实时显示"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top"
                                             TextAlignment="Center"
                                             TextWrapping="Wrap"
                                             Style="{StaticResource CaptionTextStyle}"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem.Content>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ========================================
             底部操作栏
             ======================================== -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarContainerStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                    <Button Name="HelpButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="HelpButton_Click"
                            ToolTip="查看帮助信息"
                            Margin="0,0,8,0">
                        <iconPacks:PackIconMaterial Kind="HelpCircle" Width="20" Height="20"/>
                    </Button>

                    <Button Name="SaveAndContinueButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveAndContinueButton_Click"
                            Margin="0,0,8,0"
                            ToolTip="保存当前设置并继续添加任务">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Style="{StaticResource Icon16Style}"/>
                            <TextBlock Text="保存并继续"/>
                        </StackPanel>
                    </Button>

                    <Button Name="CompleteButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CompleteButton_Click"
                            ToolTip="完成图像编辑并添加到任务列表">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Check" Style="{StaticResource Icon16Style}"/>
                            <TextBlock Text="完成"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <!-- 校验状态提示标签 -->
        <Border Name="ValidationStatusPanel"
                Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSM}"
                Padding="8,4"
                Margin="12,4,0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Name="ValidationStatusIcon"
                                          Kind="Information"
                                          Width="16" Height="16"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Name="ValidationStatusText"
                         Text="点击校验按钮进行图像匹配测试"
                         Style="{StaticResource BodyTextStyle}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"/>
            </StackPanel>
        </Border>

        <!-- 鼠标位置显示 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,4,12,4">
            <iconPacks:PackIconMaterial Kind="Crosshairs"
                                      Width="16" Height="16"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock x:Name="MousePositionLabel"
                     Text="鼠标位置: (0, 0) | DPI: 1.00x"
                     Style="{StaticResource BodyTextStyle}"
                     FontFamily="Consolas"
                     VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
