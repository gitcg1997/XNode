<Window x:Class="XNode.Windows.ImageEditor.MultiImageSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="选择模板图片 (支持多选)"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 引入应用样式 -->
                <ResourceDictionary Source="/XNode;component/Windows/ImageEditor/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 通用图标样式 -->
            <Style x:Key="Icon16Style" TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLG}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource SecondaryGradientBrush}"
                        CornerRadius="{StaticResource RadiusMD}"
                        Width="32" Height="32"
                        Margin="0,0,12,0">
                    <iconPacks:PackIconMaterial Kind="ImageMultiple"
                                              Width="18" Height="18"
                                              Foreground="White"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="从图片库选择模板图片"
                               Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="支持多选图片作为识别模板"
                               Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="{StaticResource BorderThin}"
                    CornerRadius="{StaticResource RadiusMD}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial Grid.Column="0"
                                              Kind="Magnify"
                                              Width="20" Height="20"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              Margin="12,0,8,0"
                                              VerticalAlignment="Center"/>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             Height="40"
                             Padding="0,0,12,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <TextBlock Grid.Column="1"
                               Text="搜索图片..."
                               Foreground="{StaticResource TextDisabledBrush}"
                               FontSize="14"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=Text}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- 图片库列表 -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusMD}"
                Padding="{StaticResource SpacingMD}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 提示信息 -->
                <Border Grid.Row="0"
                        Background="#E3F2FD"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="{StaticResource BorderThin}"
                        CornerRadius="{StaticResource RadiusSM}"
                        Padding="{StaticResource SpacingMD}"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Lightbulb"
                                                  Width="16" Height="16"
                                                  Foreground="{StaticResource SuccessBrush}"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="提示: 按住"/>
                            <Run Text="Ctrl" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text="点击选择多张图片，或按"/>
                            <Run Text="Shift" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text="连续选择"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 图片列表 -->
                <ListBox x:Name="LibraryImagesListBox"
                         Grid.Row="1"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="LibraryImagesListBox_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Height="180"
                                    Margin="8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="{StaticResource BorderThin}"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 图片预览 -->
                                    <Border Grid.Row="0"
                                            Background="#F5F5F5"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Margin="0,0,0,8">
                                        <Image Source="{Binding ThumbnailPath}"
                                               Stretch="Uniform"
                                               Margin="4"/>
                                    </Border>

                                    <!-- 图片信息 -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Category}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 选中标记 -->
                                    <Border Grid.Row="0"
                                            Width="28" Height="28"
                                            Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="14"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-4,-4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <iconPacks:PackIconMaterial Kind="Check"
                                                                  Width="16" Height="16"
                                                                  Foreground="White"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态提示 -->
                <StackPanel Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=LibraryImagesListBox, Path=Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <iconPacks:PackIconMaterial Kind="ImageOff"
                                              Width="64" Height="64"
                                              Foreground="{StaticResource TextDisabledBrush}"
                                              Margin="0,0,0,16"/>
                    <TextBlock Text="图片库为空"
                               Style="{StaticResource SubtitleTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="请先添加图片到图片库"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 选择统计 -->
        <Border Grid.Row="3"
                Background="#E3F2FD"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSM}"
                Padding="{StaticResource SpacingMD}"
                Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="SelectionCountText"
                           Text="未选择图片"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,12,0"
                        Click="SelectAllButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="SelectAll" Style="{StaticResource Icon16Style}"/>
                        <TextBlock Text="全选"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ClearSelectionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" Style="{StaticResource Icon16Style}"/>
                        <TextBlock Text="清空"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="100"
                    Margin="0,0,12,0"
                    Click="ConfirmButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Style="{StaticResource Icon16Style}"/>
                    <TextBlock Text="确定"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="100"
                    Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Style="{StaticResource Icon16Style}"/>
                    <TextBlock Text="取消"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
